<div class="fixture-card-wrapper">
    @if (!string.IsNullOrEmpty(TituloJornada))
    {
        <h2 class="fixture-title">@TituloJornada</h2>
    }

    @if (Partidos != null && Partidos.Any())
    {
        <div class="fixture-grid-container">
            @foreach (var partido in Partidos)
            {
                <MatchCard Partido="partido"
                           Jornada="Jornada"
                           ResultadoGlobal="ObtenerGlobalParaPartido(partido)"
                           OnPartidoSeleccionado="OnPartidoSeleccionado" />
            }
        </div>
    }
    else
    {
        <div class="fixture-empty-state">
            <p>No hay partidos programados para esta fecha.</p>
        </div>
    }
</div>