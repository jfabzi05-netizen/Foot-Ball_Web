@using ProyectoWebFutbol.Models.Dominio

<div class="torneo-nav-container">
    @if (Fases != null && Fases.Any())
    {
        @foreach (var fase in Fases)
        {
            <!-- Título de la Fase (Ej: Fase de Grupos / Apertura / Clausura) -->
            <div class="nav-fase-header">
                @fase.Nombre
            </div>

            @foreach (var grupo in fase.Grupos)
            {
                bool esTablaActiva = MostrarTabla && GrupoSeleccionado == grupo;
                // Está desplegado SOLO si es el grupo guardado en la variable activa
                bool estaDesplegado = grupoDesplegado == grupo;
                bool estaColapsado = !estaDesplegado;

                <!-- Título del Grupo con opción de desplegar/contraer -->
                <div class="nav-grupo-header" style="background-color: @ColorTorneo;">
                    <!-- Clic en el nombre para desplegar este grupo y cerrar los demás -->
                    <div class="grupo-title-container" @onclick="() => ToggleGrupo(grupo)">
                        <button type="button" class="btn-chevron" title="@(estaColapsado ? "Desplegar" : "Contraer")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="@(estaColapsado ? "chevron-collapsed" : "")">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <span>@grupo.Nombre</span>
                    </div>

                    @if (grupo.HayTabla)
                    {
                        <button type="button"
                                class="btn-tabla @(esTablaActiva ? "active" : "")"
                                title="Ver tabla de posiciones"
                                @onclick:stopPropagation="true"
                                @onclick="() => SeleccionarTabla(grupo, fase)">
                            <!-- Icono SVG de Tabla -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                <line x1="3" y1="15" x2="21" y2="15"></line>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Lista de Jornadas (Solo se muestra si está desplegado) -->
                @if (estaDesplegado)
                {
                    <div class="nav-jornadas-list">
                        @foreach (var jornada in grupo.Jornadas)
                        {
                            bool esActiva = !MostrarTabla && JornadaSeleccionada == jornada;
                            <button type="button"
                                    class="nav-jornada-item @(esActiva ? "active" : "")"
                                    @onclick="() => SeleccionarJornada(jornada, grupo, fase)">
                                @jornada.Nombre
                            </button>
                        }
                    </div>
                }
            }
        }
    }
</div>

@code {
    [Parameter] public List<FaseTorneo> Fases { get; set; } = new();
    [Parameter] public string ColorTorneo { get; set; } = "#ff4d4d";
    [Parameter] public JornadaTorneo? JornadaSeleccionada { get; set; }
    [Parameter] public GrupoTorneo? GrupoSeleccionado { get; set; }
    [Parameter] public FaseTorneo? FaseSeleccionada { get; set; }
    [Parameter] public bool MostrarTabla { get; set; }

    [Parameter] public EventCallback<JornadaTorneo?> OnJornadaSeleccionada { get; set; }
    [Parameter] public EventCallback<GrupoTorneo> OnGrupoSeleccionado { get; set; }
    [Parameter] public EventCallback<FaseTorneo> OnFaseSeleccionada { get; set; }
    [Parameter] public EventCallback<bool> OnMostrarTablaChanged { get; set; }

    // Almacena ÚNICAMENTE el grupo que se encuentra expandido
    private GrupoTorneo? grupoDesplegado;

    protected override void OnParametersSet()
    {
        // Si hay un grupo seleccionado externamente, asegurar que sea el desplegado
        if (GrupoSeleccionado != null)
        {
            grupoDesplegado = GrupoSeleccionado;
        }
        else if (grupoDesplegado == null && Fases.Any() && Fases.First().Grupos.Any())
        {
            // Por defecto abre el primer grupo si no hay selección activa
            grupoDesplegado = Fases.First().Grupos.First();
        }
    }

    private void ToggleGrupo(GrupoTorneo grupo)
    {
        // Si presiona el que ya está abierto, se colapsa (queda null).
        // Si presiona uno diferente, se asigna como el nuevo abierto y cierra automáticamente el anterior.
        if (grupoDesplegado == grupo)
        {
            grupoDesplegado = null;
        }
        else
        {
            grupoDesplegado = grupo;
        }
    }

    private async Task SeleccionarJornada(JornadaTorneo jornada, GrupoTorneo grupo, FaseTorneo fase)
    {
        grupoDesplegado = grupo;

        if (FaseSeleccionada != fase)
        {
            FaseSeleccionada = fase;
            await OnFaseSeleccionada.InvokeAsync(fase);
        }

        if (GrupoSeleccionado != grupo)
        {
            GrupoSeleccionado = grupo;
            await OnGrupoSeleccionado.InvokeAsync(grupo);
        }

        if (MostrarTabla)
        {
            MostrarTabla = false;
            await OnMostrarTablaChanged.InvokeAsync(false);
        }

        if (JornadaSeleccionada != jornada)
        {
            JornadaSeleccionada = jornada;
            await OnJornadaSeleccionada.InvokeAsync(jornada);
        }
    }

    private async Task SeleccionarTabla(GrupoTorneo grupo, FaseTorneo fase)
    {
        grupoDesplegado = grupo;

        if (FaseSeleccionada != fase)
        {
            FaseSeleccionada = fase;
            await OnFaseSeleccionada.InvokeAsync(fase);
        }

        if (GrupoSeleccionado != grupo)
        {
            GrupoSeleccionado = grupo;
            await OnGrupoSeleccionado.InvokeAsync(grupo);
        }

        if (JornadaSeleccionada != null)
        {
            JornadaSeleccionada = null;
            await OnJornadaSeleccionada.InvokeAsync(null);
        }

        if (!MostrarTabla)
        {
            MostrarTabla = true;
            await OnMostrarTablaChanged.InvokeAsync(true);
        }
    }
}