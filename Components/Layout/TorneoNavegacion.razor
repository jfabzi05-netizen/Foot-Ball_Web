@using ProyectoWebFutbol.Models.Dominio

<div class="torneo-nav-container">
    @if (Fases != null && Fases.Any())
    {
        @foreach (var fase in Fases)
        {
            <!-- Título de la Fase (Ej: Fase de Grupos / Fase de Liga) -->
            <div class="nav-fase-header">
                @fase.Nombre
            </div>

            @foreach (var grupo in fase.Grupos)
            {
                bool esTablaActiva = MostrarTabla && GrupoSeleccionado == grupo;
                bool estaColapsado = gruposColapsados.Contains(grupo);

                <!-- Título del Grupo con opción de desplegar/contraer -->
                <div class="nav-grupo-header" style="background-color: @ColorTorneo;">
                    <!-- Clic en el nombre para contraer/desplegar -->
                    <div class="grupo-title-container" @onclick="() => ToggleGrupo(grupo)">
                        <button type="button" class="btn-chevron" title="@(estaColapsado ? "Desplegar" : "Contraer")">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="@(estaColapsado ? "chevron-collapsed" : "")">
                                <polyline points="6 9 12 15 18 9"></polyline>
                            </svg>
                        </button>
                        <span>@grupo.Nombre</span>
                    </div>

                    @if (grupo.HayTabla)
                    {
                        <button type="button"
                                class="btn-tabla @(esTablaActiva ? "active" : "")"
                                title="Ver tabla de posiciones"
                                @onclick:stopPropagation="true"
                                @onclick="() => SeleccionarTabla(grupo, fase)">
                            <!-- Icono SVG de Tabla -->
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                                <line x1="3" y1="9" x2="21" y2="9"></line>
                                <line x1="3" y1="15" x2="21" y2="15"></line>
                                <line x1="9" y1="3" x2="9" y2="21"></line>
                            </svg>
                        </button>
                    }
                </div>

                <!-- Lista de Jornadas (Solo se muestra si NO está colapsado) -->
                @if (!estaColapsado)
                {
                    <div class="nav-jornadas-list">
                        @foreach (var jornada in grupo.Jornadas)
                        {
                            bool esActiva = !MostrarTabla && JornadaSeleccionada == jornada;
                            <button type="button"
                                    class="nav-jornada-item @(esActiva ? "active" : "")"
                                    @onclick="() => SeleccionarJornada(jornada, grupo, fase)">
                                @jornada.Nombre
                            </button>
                        }
                    </div>
                }
            }
        }
    }
</div>

@code {
    [Parameter] public List<FaseTorneo> Fases { get; set; } = new();
    [Parameter] public string ColorTorneo { get; set; } = "#ff4d4d";
    [Parameter] public JornadaTorneo? JornadaSeleccionada { get; set; }
    [Parameter] public GrupoTorneo? GrupoSeleccionado { get; set; }
    [Parameter] public FaseTorneo? FaseSeleccionada { get; set; }
    [Parameter] public bool MostrarTabla { get; set; }

    [Parameter] public EventCallback<JornadaTorneo?> OnJornadaSeleccionada { get; set; }
    [Parameter] public EventCallback<GrupoTorneo> OnGrupoSeleccionado { get; set; }
    [Parameter] public EventCallback<FaseTorneo> OnFaseSeleccionada { get; set; }
    [Parameter] public EventCallback<bool> OnMostrarTablaChanged { get; set; }

    // Estado local para mantener los grupos colapsados
    private HashSet<GrupoTorneo> gruposColapsados = new();

    private void ToggleGrupo(GrupoTorneo grupo)
    {
        if (gruposColapsados.Contains(grupo))
        {
            gruposColapsados.Remove(grupo);
        }
        else
        {
            gruposColapsados.Add(grupo);
        }
    }

    private async Task SeleccionarJornada(JornadaTorneo jornada, GrupoTorneo grupo, FaseTorneo fase)
    {
        if (FaseSeleccionada != fase)
        {
            FaseSeleccionada = fase;
            await OnFaseSeleccionada.InvokeAsync(fase);
        }

        if (GrupoSeleccionado != grupo)
        {
            GrupoSeleccionado = grupo;
            await OnGrupoSeleccionado.InvokeAsync(grupo);
        }

        if (MostrarTabla)
        {
            MostrarTabla = false;
            await OnMostrarTablaChanged.InvokeAsync(false);
        }

        if (JornadaSeleccionada != jornada)
        {
            JornadaSeleccionada = jornada;
            await OnJornadaSeleccionada.InvokeAsync(jornada);
        }
    }

    private async Task SeleccionarTabla(GrupoTorneo grupo, FaseTorneo fase)
    {
        if (FaseSeleccionada != fase)
        {
            FaseSeleccionada = fase;
            await OnFaseSeleccionada.InvokeAsync(fase);
        }

        if (GrupoSeleccionado != grupo)
        {
            GrupoSeleccionado = grupo;
            await OnGrupoSeleccionado.InvokeAsync(grupo);
        }

        if (JornadaSeleccionada != null)
        {
            JornadaSeleccionada = null;
            await OnJornadaSeleccionada.InvokeAsync(null);
        }

        if (!MostrarTabla)
        {
            MostrarTabla = true;
            await OnMostrarTablaChanged.InvokeAsync(true);
        }
    }
}

<style>
    .torneo-nav-container {
        width: 100%;
        display: flex;
        flex-direction: column;
        font-family: Inter, sans-serif;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.08);
        border-radius: 6px;
        overflow: hidden;
        background-color: #ffffff;
    }

    .nav-fase-header {
        background-color: #000000;
        color: #ffffff;
        font-weight: 700;
        padding: 12px 16px;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .nav-grupo-header {
        color: #ffffff;
        font-weight: 600;
        padding: 10px 16px;
        font-size: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        user-select: none;
    }

    .grupo-title-container {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        flex: 1;
    }

    .btn-chevron {
        background: transparent;
        border: none;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        cursor: pointer;
    }

        .btn-chevron svg {
            transition: transform 0.2s ease;
        }

            .btn-chevron svg.chevron-collapsed {
                transform: rotate(-90deg);
            }

    /* Estilo del botón del icono de tabla */
    .btn-tabla {
        background: transparent;
        border: none;
        color: rgba(255, 255, 255, 0.85);
        cursor: pointer;
        padding: 4px 6px;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

        .btn-tabla:hover {
            background-color: rgba(255, 255, 255, 0.25);
            color: #ffffff;
        }

        .btn-tabla.active {
            background-color: #ffffff;
            color: #000000;
        }

    /* Lista de Jornadas/Rondas */
    .nav-jornadas-list {
        display: flex;
        flex-direction: column;
        background-color: #f9f9f9;
        max-height: 320px;
        overflow-y: auto;
    }

        .nav-jornadas-list::-webkit-scrollbar {
            width: 6px;
        }

        .nav-jornadas-list::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .nav-jornadas-list::-webkit-scrollbar-thumb {
            background: #cccccc;
            border-radius: 3px;
        }

            .nav-jornadas-list::-webkit-scrollbar-thumb:hover {
                background: #aaaaaa;
            }

    .nav-jornada-item {
        border: none;
        background: transparent;
        text-align: left;
        padding: 11px 18px;
        font-weight: 500;
        font-size: 14px;
        color: #333333;
        cursor: pointer;
        transition: all 0.2s ease;
        width: 100%;
        border-left: 4px solid transparent;
        box-sizing: border-box;
    }

        .nav-jornada-item:hover {
            background-color: #ececec;
            color: #000000;
        }

        .nav-jornada-item.active {
            background-color: #e2e2e2;
            color: #000000;
            font-weight: 700;
            border-left-color: #000000;
        }
</style>