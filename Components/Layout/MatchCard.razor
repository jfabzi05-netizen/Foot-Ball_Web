@if (Partido != null)
{
    bool mostrarFooterGlobal = EsJornadaVuelta && ResultadoGlobal != null;

    <div class="match-card-wrapper">
        <div class="match-card @(mostrarFooterGlobal ? "has-footer" : "")">
            <!-- Contenido Principal: Equipos, Banderas y Marcadores -->
            <div class="match-content">
                <!-- Equipo Local -->
                <div class="match-row">
                    <div class="match-team">
                        @if (Partido.MarcadorLocal.Equipo != null)
                        {
                            <img src="@Partido.MarcadorLocal.Equipo.UrlImagen"
                                 onerror="this.onerror=null; this.src='public/assets/logo_not_found.png';"
                                 alt="@Partido.MarcadorLocal.Equipo.Nombre"
                                 class="team-flag"
                                 loading="lazy" />
                            <span class="team-name" style="cursor: pointer;" @onclick="SeleccionarPartido">
                                @Partido.MarcadorLocal.Equipo.Nombre
                            </span>
                        }
                        else
                        {
                            <span class="team-name">Por definir</span>
                        }
                    </div>
                    <div class="match-scores">
                        @if (Partido.MarcadorLocal.Penales.HasValue)
                        {
                            <span class="penalties-score">(@Partido.MarcadorLocal.Penales)</span>
                        }
                        <input type="number"
                               class="score-input @(EsGanadorLocal ? "winner" : "")"
                               value="@Partido.MarcadorLocal.Score"
                               @onchange="(e) => CambiarScoreLocal(e)"
                               @onblur="GuardarCambiosAsync"
                               min="0" />
                    </div>
                </div>

                <!-- Equipo Visitante -->
                <div class="match-row">
                    <div class="match-team">
                        @if (Partido.MarcadorVisita.Equipo != null)
                        {
                            <img src="@Partido.MarcadorVisita.Equipo.UrlImagen"
                                 onerror="this.onerror=null; this.src='public/assets/logo_not_found.png';"
                                 alt="@Partido.MarcadorVisita.Equipo.Nombre"
                                 class="team-flag"
                                 loading="lazy" />
                            <span class="team-name" style="cursor: pointer;" @onclick="SeleccionarPartido">
                                @Partido.MarcadorVisita.Equipo.Nombre
                            </span>
                        }
                        else
                        {
                            <span class="team-name">Por definir</span>
                        }
                    </div>
                    <div class="match-scores">
                        @if (Partido.MarcadorVisita.Penales.HasValue)
                        {
                            <span class="penalties-score">(@Partido.MarcadorVisita.Penales)</span>
                        }
                        <input type="number"
                               class="score-input @(EsGanadorVisita ? "winner" : "")"
                               value="@Partido.MarcadorVisita.Score"
                               @onchange="(e) => CambiarScoreVisita(e)"
                               @onblur="GuardarCambiosAsync"
                               min="0" />
                    </div>
                </div>
            </div>

            <!-- Línea Vertical Separadora -->
            <div class="divider"></div>

            <!-- Estado del Partido (FT, TBD, LIVE) -->
            <div class="status-container">
                <span class="status-text clickable @ObtenerClaseEstado()" @onclick="RotarEstadoAsync">
                    @ObtenerTextoEstado()
                </span>
            </div>
        </div>

        <!-- Franja del Global (Solo si aplica) -->
        @if (mostrarFooterGlobal)
        {
            bool esLocalEnGlobal = ResultadoGlobal!.GlobalLocal?.Equipo?.Nombre == Partido.MarcadorLocal?.Equipo?.Nombre;
            int golesLocal = esLocalEnGlobal ? (ResultadoGlobal.GlobalLocal?.Score ?? 0) : (ResultadoGlobal.GlobalVisita?.Score ?? 0);
            int golesVisita = esLocalEnGlobal ? (ResultadoGlobal.GlobalVisita?.Score ?? 0) : (ResultadoGlobal.GlobalLocal?.Score ?? 0);

            <div class="match-global-footer">
                <span class="global-label">GLOBAL</span>
                <span class="global-score">@golesLocal - @golesVisita</span>
                @if (ResultadoGlobal.GlobalLocal?.Penales != null || ResultadoGlobal.GlobalVisita?.Penales != null)
                {
                    int penLocal = esLocalEnGlobal ? (ResultadoGlobal.GlobalLocal?.Penales ?? 0) : (ResultadoGlobal.GlobalVisita?.Penales ?? 0);
                    int penVisita = esLocalEnGlobal ? (ResultadoGlobal.GlobalVisita?.Penales ?? 0) : (ResultadoGlobal.GlobalLocal?.Penales ?? 0);

                    <span class="global-penalties">(pen. @penLocal-@penVisita)</span>
                }
            </div>
        }
    </div>
}