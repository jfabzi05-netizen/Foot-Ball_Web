@* Components/Pages/Nacionales.razor *@
@page "/nacionales"
@rendermode InteractiveServer

<div class="torneos-page-container">
    <main class="torneos-content">
        @if (torneos == null)
        {
            <PantallaCarga Mensaje="Cargando torneos..." Alto="85vh" />
        }
        else if (!torneos.Any())
        {
            <div class="empty-state">
                <p>No hay torneos registrados actualmente.</p>
            </div>
        }
        else
        {
            <div class="torneos-stack-list">
                @foreach (var torneo in torneos)
                {
                    <TorneoCard Torneo="torneo" />
                }
            </div>
        }
    </main>
</div>

@code {
    private List<Torneo>? torneos;

    protected override async Task OnInitializedAsync()
    {
        // 1. Inicia la carga en segundo plano sin congelar la respuesta de la navegación
        _ = CargarDatosAsync();
    }

    private async Task CargarDatosAsync()
    {
        // 2. Libera el hilo inicial para que Blazor pinte inmediatamente la página con <PantallaCarga />
        await Task.Yield();

        // 3. Consulta la base de datos
        List<Torneo>? lista = await DomainService.ObtenerTorneosAsync();
        torneos = lista?.Where(t => t.TipoTorneo == Models.Enums.TipoTorneo.Nacional)
                        .ToList() ?? new List<Torneo>();

        // 4. Notifica a Blazor que los datos terminaron de cargar para sustituir la carga por los torneos
        StateHasChanged();
    }
}